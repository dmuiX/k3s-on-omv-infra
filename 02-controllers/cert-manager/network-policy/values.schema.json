{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterNetwork"],
  "properties": {
    "clusterNetwork": {
      "type": "object",
      "required": ["kubernetesApiServerEndpointCIDRs"],
      "properties": {
        "kubernetesApiServerEndpointCIDRs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"
          }
        }
      }
    }
  }
}
