{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterNetwork"],
  "properties": {
    "clusterNetwork": {
      "type": "object",
      "required": ["kubernetesApiServerEndpointCIDRs"],
      "properties": {
        "kubernetesApiServerEndpointCIDRs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
          }
        }
      }
    }
  }
}
