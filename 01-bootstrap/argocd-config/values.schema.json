{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gateway", "routes"],
  "properties": {
    "gateway": {
      "type": "object",
      "required": ["name", "namespace", "listener"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "listener": {"type": "string", "minLength": 1}
      }
    },
    "routes": {
      "type": "object",
      "required": ["argocd"],
      "properties": {
        "argocd": {
          "type": "object",
          "required": ["hostname"],
          "properties": {
            "hostname": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
