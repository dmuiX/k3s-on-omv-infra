{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["component"],
  "properties": {
    "component": {
      "type": "string",
      "enum": ["none", "argocd", "grafana", "longhorn", "openbao", "certificates", "backups", "postgresql", "restore"]
    },
    "backup": {
      "type": "object",
      "required": ["restoreOrdinal"],
      "properties": {
        "restoreOrdinal": {
          "description": "OpenBao StatefulSet ordinal to restore; never coerce invalid input to ordinal zero.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "clusterNetwork": {
      "type": "object",
      "properties": {
        "kubernetesApiServerEndpointCIDRs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "postgresqlBackup": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[^/]+/?$"},
        "bucket": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "accessKeyIdRef": {"type": "string", "pattern": "^vault:"},
        "secretAccessKeyRef": {"type": "string", "pattern": "^vault:"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"component": {"const": "postgresql"}}},
      "then": {
        "properties": {
          "clusterNetwork": {
            "required": ["kubernetesApiServerEndpointCIDRs"],
            "properties": {
              "kubernetesApiServerEndpointCIDRs": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"
                }
              }
            }
          },
          "postgresqlBackup": {
            "required": ["endpoint", "bucket", "region", "accessKeyIdRef", "secretAccessKeyRef"]
          }
        }
      }
    }
  ]
}
