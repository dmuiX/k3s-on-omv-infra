{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["component"],
  "properties": {
    "component": {
      "type": "string",
      "enum": ["none", "argocd", "grafana", "longhorn", "openbao", "certificates", "backups", "openbao-pki-network", "postgresql", "restore"]
    },
    "backup": {
      "type": "object",
      "required": ["restoreOrdinal"],
      "properties": {
        "restoreOrdinal": {
          "description": "OpenBao StatefulSet ordinal to restore; never coerce invalid input to ordinal zero.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "clusterNetwork": {
      "type": "object",
      "properties": {
        "kubernetesApiServerEndpointCIDRs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"},
          "uniqueItems": true
        }
      }
    },
    "postgresqlBackup": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[^/]+/?$"},
        "bucket": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "accessKeyIdRef": {"type": "string", "pattern": "^vault:"},
        "secretAccessKeyRef": {"type": "string", "pattern": "^vault:"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"component": {"const": "openbao-pki-network"}}},
      "then": {
        "properties": {
          "clusterNetwork": {
            "required": ["kubernetesApiServerEndpointCIDRs"],
            "properties": {
              "kubernetesApiServerEndpointCIDRs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"component": {"const": "postgresql"}}},
      "then": {
        "properties": {
          "postgresqlBackup": {
            "required": ["endpoint", "bucket", "region", "accessKeyIdRef", "secretAccessKeyRef"]
          }
        }
      }
    }
  ]
}
