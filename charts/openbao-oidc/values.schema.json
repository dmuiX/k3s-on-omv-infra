{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "openbaoOIDC"
  ],
  "properties": {
    "openbaoOIDC": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerConfigName": {
          "type": "string",
          "minLength": 1
        },
        "deletionPolicy": {
          "type": "string",
          "enum": [
            "Orphan",
            "Delete"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "syncWave": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              },
              "externalName": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "internal"
                ]
              },
              "externalMemberEntityIds": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "externalName",
              "type",
              "externalMemberEntityIds"
            ]
          }
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "syncWave": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              },
              "groupRefs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "groupRefs"
            ]
          }
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "syncWave": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "algorithm": {
              "enum": [
                "RS256"
              ]
            },
            "allowedClientIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rotationPeriod": {
              "type": "integer",
              "minimum": 1
            },
            "verificationTtl": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "name",
            "algorithm",
            "allowedClientIds",
            "rotationPeriod",
            "verificationTtl"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "syncWave": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              },
              "template": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "template"
            ]
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "syncWave": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "assignments": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "redirectUris": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^/]+/.+"
              }
            },
            "idTokenTtl": {
              "type": "integer",
              "minimum": 1
            },
            "accessTokenTtl": {
              "type": "integer",
              "minimum": 1
            },
            "connectionSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "namespace"
              ]
            }
          },
          "required": [
            "name",
            "key",
            "assignments",
            "redirectUris",
            "idTokenTtl",
            "accessTokenTtl"
          ]
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "syncWave": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "issuerURL": {
              "type": "string",
              "pattern": "^https://[^/]+/v1/identity/oidc/provider/[^/]+$"
            },
            "clientRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scopeRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "name",
            "issuerURL",
            "clientRefs",
            "scopeRefs"
          ]
        }
      },
      "required": [
        "providerConfigName",
        "deletionPolicy",
        "key",
        "scopes",
        "client",
        "provider"
      ]
    }
  }
}
